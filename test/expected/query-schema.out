CREATE EXTENSION query_schema;
CREATE TYPE listing_status AS ENUM ('draft', 'active', 'sold');
CREATE TABLE users (id int PRIMARY KEY, email text NOT NULL, bio text, created_at timestamptz NOT NULL);
CREATE TABLE listings (
  id int PRIMARY KEY,
  seller_id int NOT NULL REFERENCES users,
  title text NOT NULL,
  price_kobo bigint NOT NULL,
  status listing_status NOT NULL,
  tags text[] NOT NULL,
  rating numeric,
  sold_at timestamptz,
  published_on date
);
CREATE TABLE photos (id int PRIMARY KEY, listing_id int NOT NULL REFERENCES listings, url text NOT NULL);
SELECT * FROM query_shape($$
  SELECT u.id, u.email, u.bio, l.title, p.url
  FROM users u
  LEFT JOIN listings l ON l.seller_id = u.id
  LEFT JOIN photos p ON p.listing_id = l.id
$$);
 path  | pg_type | nullable |            schema            | note 
-------+---------+----------+------------------------------+------
 id    | integer | f        | Schema.Number                | 
 email | text    | f        | Schema.String                | 
 bio   | text    | t        | Schema.NullOr(Schema.String) | 
 title | text    | t        | Schema.NullOr(Schema.String) | 
 url   | text    | t        | Schema.NullOr(Schema.String) | 
(5 rows)

SELECT * FROM query_shape($$
  SELECT l.title, u.email FROM listings l RIGHT JOIN users u ON u.id = l.seller_id
$$);
 path  | pg_type | nullable |            schema            | note 
-------+---------+----------+------------------------------+------
 title | text    | t        | Schema.NullOr(Schema.String) | 
 email | text    | f        | Schema.String                | 
(2 rows)

SELECT * FROM query_shape($$
  SELECT u.email, l.title FROM users u LEFT JOIN listings l ON l.seller_id = u.id WHERE l.id IS NOT NULL
$$);
 path  | pg_type | nullable |    schema     | note 
-------+---------+----------+---------------+------
 email | text    | f        | Schema.String | 
 title | text    | f        | Schema.String | 
(2 rows)

SELECT * FROM query_shape($$
  SELECT u.id, u.email,
    count(l.id) AS listing_count,
    max(l.price_kobo) AS top_price,
    coalesce(json_agg(json_build_object(
      'id', l.id,
      'title', l.title,
      'priceKobo', l.price_kobo,
      'priceKoboText', l.price_kobo::text,
      'status', l.status,
      'tags', l.tags,
      'rating', l.rating,
      'soldAt', l.sold_at,
      'publishedOn', l.published_on,
      'photos', coalesce((SELECT json_agg(json_build_object('url', p.url)) FROM photos p WHERE p.listing_id = l.id), '[]')
    ) ORDER BY l.id) FILTER (WHERE l.id IS NOT NULL), '[]') AS listings
  FROM users u
  LEFT JOIN listings l ON l.seller_id = u.id
  GROUP BY u.id, u.email
$$);
           path           |             pg_type              | nullable |                                                                                                                                                                                                                     schema                                                                                                                                                                                                                     |                      note                      
--------------------------+----------------------------------+----------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+------------------------------------------------
 id                       | integer                          | f        | Schema.Number                                                                                                                                                                                                                                                                                                                                                                                                                                  | 
 email                    | text                             | f        | Schema.String                                                                                                                                                                                                                                                                                                                                                                                                                                  | 
 listing_count            | bigint                           | f        | Schema.BigInt                                                                                                                                                                                                                                                                                                                                                                                                                                  | 
 top_price                | bigint                           | t        | Schema.NullOr(Schema.BigInt)                                                                                                                                                                                                                                                                                                                                                                                                                   | 
 listings                 | json array                       | f        | Schema.Array(Schema.Struct({ id: Schema.Number, title: Schema.String, priceKobo: Schema.Number, priceKoboText: Schema.BigIntFromString, status: Schema.Literals(["draft", "active", "sold"]), tags: Schema.Array(Schema.NullOr(Schema.String)), rating: Schema.NullOr(Schema.Number), soldAt: Schema.NullOr(Schema.DateFromString), publishedOn: Schema.NullOr(Schema.String), photos: Schema.Array(Schema.Struct({ url: Schema.String })) })) | 
 listings[]               | json object                      | f        | Schema.Struct({ id: Schema.Number, title: Schema.String, priceKobo: Schema.Number, priceKoboText: Schema.BigIntFromString, status: Schema.Literals(["draft", "active", "sold"]), tags: Schema.Array(Schema.NullOr(Schema.String)), rating: Schema.NullOr(Schema.Number), soldAt: Schema.NullOr(Schema.DateFromString), publishedOn: Schema.NullOr(Schema.String), photos: Schema.Array(Schema.Struct({ url: Schema.String })) })               | 
 listings[].id            | integer in json                  | f        | Schema.Number                                                                                                                                                                                                                                                                                                                                                                                                                                  | 
 listings[].title         | text in json                     | f        | Schema.String                                                                                                                                                                                                                                                                                                                                                                                                                                  | 
 listings[].priceKobo     | bigint in json                   | f        | Schema.Number                                                                                                                                                                                                                                                                                                                                                                                                                                  | JSON number can lose precision, cast to ::text
 listings[].priceKoboText | text in json                     | f        | Schema.BigIntFromString                                                                                                                                                                                                                                                                                                                                                                                                                        | 
 listings[].status        | listing_status in json           | f        | Schema.Literals(["draft", "active", "sold"])                                                                                                                                                                                                                                                                                                                                                                                                   | 
 listings[].tags          | json array                       | f        | Schema.Array(Schema.NullOr(Schema.String))                                                                                                                                                                                                                                                                                                                                                                                                     | 
 listings[].tags[]        | text in json                     | t        | Schema.NullOr(Schema.String)                                                                                                                                                                                                                                                                                                                                                                                                                   | nullability unknown, assumed nullable
 listings[].rating        | numeric in json                  | t        | Schema.NullOr(Schema.Number)                                                                                                                                                                                                                                                                                                                                                                                                                   | JSON number can lose precision, cast to ::text
 listings[].soldAt        | timestamp with time zone in json | t        | Schema.NullOr(Schema.DateFromString)                                                                                                                                                                                                                                                                                                                                                                                                           | 
 listings[].publishedOn   | date in json                     | t        | Schema.NullOr(Schema.String)                                                                                                                                                                                                                                                                                                                                                                                                                   | 
 listings[].photos        | json array                       | f        | Schema.Array(Schema.Struct({ url: Schema.String }))                                                                                                                                                                                                                                                                                                                                                                                            | 
 listings[].photos[]      | json object                      | f        | Schema.Struct({ url: Schema.String })                                                                                                                                                                                                                                                                                                                                                                                                          | 
 listings[].photos[].url  | text in json                     | f        | Schema.String                                                                                                                                                                                                                                                                                                                                                                                                                                  | 
(19 rows)

SELECT query_schema($$
  SELECT u.id, u.created_at,
    coalesce(json_agg(json_build_object('title', l.title, 'soldAt', l.sold_at)) FILTER (WHERE l.id IS NOT NULL), '[]') AS listings
  FROM users u LEFT JOIN listings l ON l.seller_id = u.id
  GROUP BY u.id
$$);
                   query_schema                    
---------------------------------------------------
 Schema.Struct({                                  +
   id: Schema.Number,                             +
   created_at: Schema.Date,                       +
   listings: Schema.Array(Schema.Struct({         +
     title: Schema.String,                        +
     soldAt: Schema.NullOr(Schema.DateFromString),+
   })),                                           +
 })
(1 row)

