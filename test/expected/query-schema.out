SELECT * FROM query_shape($$
  SELECT lower(u.email) AS email, coalesce(u.bio, '') AS bio, u.bio || '!' AS shout, now() AS at,
    CASE WHEN u.bio IS NULL THEN 'none' ELSE 'some' END AS kind, u.created_at::date AS day,
    l.status, l.rating, l.tags, l.published_on
  FROM users u JOIN listings l ON l.seller_id = u.id
  WHERE u.id = $1 AND l.status = $2
$$);
     path     |         pg_type          | nullable |                    schema                    |                  note                  
--------------+--------------------------+----------+----------------------------------------------+----------------------------------------
 $1           | integer                  |          | Schema.Number                                | 
 $2           | listing_status           |          | Schema.Literals(["draft", "active", "sold"]) | 
 email        | text                     | f        | Schema.String                                | 
 bio          | text                     | f        | Schema.String                                | 
 shout        | text                     | t        | Schema.NullOr(Schema.String)                 | 
 at           | timestamp with time zone | f        | Schema.Date                                  | 
 kind         | text                     | f        | Schema.String                                | 
 day          | date                     | f        | Schema.String                                | 
 status       | listing_status           | f        | Schema.Literals(["draft", "active", "sold"]) | 
 rating       | numeric                  | t        | Schema.NullOr(Schema.String)                 | numeric is decoded as a decimal string
 tags         | text[]                   | f        | Schema.Array(Schema.NullOr(Schema.String))   | 
 tags[]       | text                     | t        | Schema.NullOr(Schema.String)                 | nullability unknown, assumed nullable
 published_on | date                     | t        | Schema.NullOr(Schema.String)                 | 
(13 rows)

SELECT * FROM query_shape($$
  INSERT INTO users (id, email, created_at) VALUES ($1, $2, now()) RETURNING id, bio, created_at
$$);
    path    |         pg_type          | nullable |            schema            | note 
------------+--------------------------+----------+------------------------------+------
 $1         | integer                  |          | Schema.Number                | 
 $2         | text                     |          | Schema.String                | 
 id         | integer                  | f        | Schema.Number                | 
 bio        | text                     | t        | Schema.NullOr(Schema.String) | 
 created_at | timestamp with time zone | f        | Schema.Date                  | 
(5 rows)

SELECT * FROM query_shape($$ SELECT 1; SELECT 2 $$);
ERROR:  query_schema expects exactly one statement
SELECT * FROM query_shape($$ VACUUM $$);
ERROR:  query_schema only describes SELECT, INSERT, UPDATE, DELETE and MERGE
SELECT * FROM query_shape($$
  SELECT
    CASE WHEN l.id IS NULL THEN NULL ELSE json_build_object('id', l.id, 'title', l.title, 'soldAt', l.sold_at) END AS listing,
    CASE WHEN l.id IS NOT NULL THEN l.title END AS title_when_present
  FROM users u LEFT JOIN listings l ON l.seller_id = u.id
$$);
        path        |             pg_type              | nullable |                                                         schema                                                          | note 
--------------------+----------------------------------+----------+-------------------------------------------------------------------------------------------------------------------------+------
 listing            | json object                      | t        | Schema.NullOr(Schema.Struct({ id: Schema.Number, title: Schema.String, soldAt: Schema.NullOr(Schema.DateFromString) })) | 
 listing.id         | integer in json                  | f        | Schema.Number                                                                                                           | 
 listing.title      | text in json                     | f        | Schema.String                                                                                                           | 
 listing.soldAt     | timestamp with time zone in json | t        | Schema.NullOr(Schema.DateFromString)                                                                                    | 
 title_when_present | text                             | t        | Schema.NullOr(Schema.String)                                                                                            | 
(5 rows)

